#!/bin/sh
# Runs the reviewed checker copy installed in Git's metadata, never the working-tree file.
set -eu
common=$(git rev-parse --path-format=absolute --git-common-dir)
checker="$common/privacy-hooks/privacy_check.py"
if [ ! -f "$checker" ]; then
    echo "Privacy guard is unavailable on this checkout; review the guard files and run python3 scripts/install_privacy_guards.py." >&2
    exit 1
fi
exec python3 "$checker" --hook commit-msg --commit-message "$1"
