# Copy to app/.env and edit only settings you need. Keep that file private.
# FRONTEND_PORT=8080
# BACKEND_PORT=5050
# PDFSEARCH_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
# ADMIN_TAILSCALE_USERS=you@example.com
# LOCAL_SINGLE_USER_MODE=false
# PDF_STORAGE_HOST_PATH=/path/to/your/pdfs
# INDEX_STORAGE_HOST_PATH=/path/to/your/indexes
# MAIL_TOKEN=replace-with-a-private-random-value
# NODERED_COORDINATOR_URL=http://your-coordinator:1881
